{
  "name": "cv-reformat-backend",
  "version": "1.0.0",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "build": "tsc && npx puppeteer browsers install chrome",
    "dev": "nodemon src/app.ts",
    "test:ai-access": "tsc && node tests/aiAccess.test.cjs",
    "test:migrations": "node tests/migrations.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:billing": "tsc && node tests/billingPolicy.test.cjs",
    "check:release": "npm run typecheck && npm run test:ai-access && npm run test:billing && npm run test:migrations && npm run test:trust && npm run test:tailoring",
    "audit:environment": "node scripts/audit-environment.cjs",
    "migrations:bundle": "node scripts/build-migration-bundle.cjs",
    "test:trust": "tsc && node tests/trustPolicy.test.cjs && node tests/trustRoutes.test.cjs && node tests/trustMigration.test.mjs",
    "test:tailoring": "tsc && node tests/tailoringAccess.test.cjs && node tests/guestTailoringMigration.test.mjs && node tests/cvImport.test.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "mammoth": "^1.9.1",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.104.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "^5.6.205",
    "puppeteer": "^25.2.1",
    "stripe": "^14.20.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.4.2",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
